From: Steven Galvis <steven.galvis@gmail.com>
Date: Fri, 23 Oct 2026 14:13:06 +0000
Subject: [PATCH] Bind mailbox approval digest to parsed descriptor bytes

---
 ops/__init__.py            |  1 +
 ops/factory/README.md      | 22 ++++++++++++++-
 ops/factory/__init__.py    |  1 +
 ops/factory/once.py        | 13 +++++++--
 tests/test_factory_once.py | 56 +++++++++++++++++++++++++++++++++++++-
 5 files changed, 88 insertions(+), 5 deletions(-)
 create mode 100644 ops/__init__.py
 create mode 100644 ops/factory/__init__.py

diff --git a/ops/__init__.py b/ops/__init__.py
new file mode 100644
index 0000000..1c1f3a5
--- /dev/null
+++ b/ops/__init__.py
@@ -0,0 +1 @@
+"""Reviewed operational helpers; explicit package prevents namespace substitution."""
diff --git a/ops/factory/README.md b/ops/factory/README.md
index 326a99c..9e23e83 100644
--- a/ops/factory/README.md
+++ b/ops/factory/README.md
@@ -188,7 +188,7 @@ anything or accept state locations from jobs. Keep the same state directory.
 After separate live-test approval, the manual invocation shape is:
 
 ```sh
-.venv/bin/python -B -m ops.factory.once --grant /approved/private/control/probe.json --state-dir /approved/private/state --token-fd 3 --acknowledge-once
+.venv/bin/python -B -m ops.factory.once --grant /approved/private/control/probe.json --grant-sha256 APPROVED_64_HEX_GRANT_FILE_HASH --state-dir /approved/private/state --token-fd 3 --acknowledge-once
 ```
 
 FD 3 must already be an inherited pipe supplied by the operator's
@@ -231,3 +231,23 @@ Authorize one manual invocation, at most two issue GETs and one comment POST,
 plus read-only verification of that exact comment/ledger. Stop afterward. Any
 credential provisioning or host/service/account/schedule change needs separate
 approval. No live job, live caller invocation or credential was created here.
+
+
+The manual caller requires `--grant-sha256`: the SHA-256 of the exact complete
+operator approval file bytes (including whitespace), distinct from the job payload
+`content_digest`. The operator supplies this non-secret hash independently of the
+mutable file. The caller safely opens the grant once, bounds its read, hashes that
+snapshot and parses those same bytes. Replacing or mutating the pathname cannot
+substitute a different grant after hash verification. An already read approved
+snapshot may still be used if the file is subsequently removed; revocation after
+consumption requires stopping the invocation, not editing the old pathname.
+Missing/malformed/mismatched hashes reject before reading credentials or creating
+state. No default hash is derived from the current pathname.
+
+For a privileged operator launcher, use system Python with `-I -S -B` and a fixed
+bootstrap that inserts only the reviewed root-owned release into `sys.path` before
+importing `ops.factory.once`. The explicit `ops` and `ops.factory` packages prevent
+namespace-package substitution. This disables environment/user-site/CWD and
+sitecustomize/.pth import injection. The OS Python interpreter and standard library
+remain trusted system dependencies. No arbitrary interpreter/source path is accepted
+by the operator helper.
diff --git a/ops/factory/__init__.py b/ops/factory/__init__.py
new file mode 100644
index 0000000..dd7dcd9
--- /dev/null
+++ b/ops/factory/__init__.py
@@ -0,0 +1 @@
+"""Dry-run mailbox package; no import-time activation."""
diff --git a/ops/factory/once.py b/ops/factory/once.py
index 6a03330..5aaea34 100644
--- a/ops/factory/once.py
+++ b/ops/factory/once.py
@@ -2,6 +2,8 @@
 import argparse
 from dataclasses import asdict
 import json
+import hashlib
+import hmac
 import os
 from pathlib import Path
 import re
@@ -44,14 +46,18 @@ def private_file(info):
         raise Rejected()
 
 
-def read_grant(path, now):
+def read_grant(path, now, expected_sha256):
+    if type(expected_sha256) is not str or not re.fullmatch(r'[0-9a-f]{64}', expected_sha256):
+        raise Rejected()
     path = Path(path)
     trusted_directory(path.parent)
     fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
     with os.fdopen(fd, 'rb') as source:
         private_file(os.fstat(source.fileno()))
         raw = source.read(MAX_GRANT + 1)
-    if len(raw) > MAX_GRANT:
+    # Hash precisely the bounded bytes from this descriptor; parse that same
+    # snapshot below. Never reopen the pathname for verification or parsing.
+    if len(raw) > MAX_GRANT or not hmac.compare_digest(hashlib.sha256(raw).hexdigest(), expected_sha256):
         raise Rejected()
     approval = strict_json(raw)
     fields = {'version', 'repository', 'mode', 'max_jobs', 'max_polls',
@@ -126,6 +132,7 @@ def reserve_poll(directory, grant):
 def main(argv=None):
     parser = QuietParser(description='Manually acknowledge one approved dry-run job once.', allow_abbrev=False)
     parser.add_argument('--grant', required=True)
+    parser.add_argument('--grant-sha256', required=True)
     parser.add_argument('--state-dir', required=True)
     parser.add_argument('--token-fd', type=int, required=True)
     parser.add_argument('--acknowledge-once', required=True, action='store_true')
@@ -134,7 +141,7 @@ def main(argv=None):
     token = ''
     try:
         args = parser.parse_args(argv)
-        grant = read_grant(args.grant, time.time())
+        grant = read_grant(args.grant, time.time(), args.grant_sha256)
         directory = state_directory(args.state_dir)
         token = read_token(args.token_fd)
         if not reserve_poll(directory, grant):
diff --git a/tests/test_factory_once.py b/tests/test_factory_once.py
index 86cb39e..3a98234 100644
--- a/tests/test_factory_once.py
+++ b/tests/test_factory_once.py
@@ -2,6 +2,7 @@
 from contextlib import ExitStack, redirect_stdout, redirect_stderr
 from dataclasses import asdict
 import io
+import hashlib
 import json
 import os
 from pathlib import Path
@@ -70,7 +71,9 @@ class OnceTests(unittest.TestCase):
         read_fd, write_fd = os.pipe()
         os.write(write_fd, (self.token if token is None else token).encode())
         os.close(write_fd)
-        args = ['--grant', str(self.grant_file), '--state-dir', str(self.state),
+        args = ['--grant', str(self.grant_file), '--grant-sha256',
+                hashlib.sha256(self.grant_file.read_bytes()).hexdigest() if self.grant_file.exists() else '0' * 64,
+                '--state-dir', str(self.state),
                 '--token-fd', str(read_fd), '--acknowledge-once', *extra]
         output = io.StringIO()
         with ExitStack() as stack:
@@ -127,6 +130,57 @@ class OnceTests(unittest.TestCase):
         self.assertIn('acknowledged', output)
         self.assertEqual(len(self.calls), 3)
 
+    def test_grant_digest_missing_or_mismatched_stops_before_credential(self):
+        for expected in ('0' * 64, 'not-a-digest', None):
+            args = ['--grant', str(self.grant_file), '--state-dir', str(self.state),
+                    '--token-fd', '3', '--acknowledge-once']
+            if expected is not None:
+                args += ['--grant-sha256', expected]
+            with patch.object(once, 'read_token') as read_token, redirect_stdout(io.StringIO()):
+                self.assertEqual(once.main(args), 2)
+                read_token.assert_not_called()
+        self.assertEqual(list(self.state.iterdir()), [])
+
+    def test_atomic_path_replacement_after_open_parses_approved_snapshot(self):
+        expected = hashlib.sha256(self.grant_file.read_bytes()).hexdigest()
+        original_open = once.os.open
+        replacement = self.root / 'replacement'
+        changed = dict(self.approval, grant=dict(self.approval['grant'], sender_id=999))
+        replacement.write_text(json.dumps(changed))
+        replacement.chmod(0o600)
+        moved = self.root / 'old-grant'
+        def replace_after_open(path, flags, *args, **kwargs):
+            fd = original_open(path, flags, *args, **kwargs)
+            if Path(path) == self.grant_file:
+                self.grant_file.rename(moved)
+                replacement.rename(self.grant_file)
+            return fd
+        with patch.object(once.os, 'open', side_effect=replace_after_open):
+            approved = once.read_grant(self.grant_file, self.now, expected)
+        self.assertEqual(approved.sender_id, 42)
+        self.assertEqual(json.loads(self.grant_file.read_bytes())['grant']['sender_id'], 999)
+
+    def test_in_place_mutation_before_read_fails_expected_digest(self):
+        expected = hashlib.sha256(self.grant_file.read_bytes()).hexdigest()
+        original_fdopen = once.os.fdopen
+        def mutate(fd, *args, **kwargs):
+            changed = dict(self.approval, grant=dict(self.approval['grant'], sender_id=999))
+            self.grant_file.write_text(json.dumps(changed))
+            return original_fdopen(fd, *args, **kwargs)
+        with patch.object(once.os, 'fdopen', side_effect=mutate), self.assertRaises(once.Rejected):
+            once.read_grant(self.grant_file, self.now, expected)
+
+    def test_mutation_after_snapshot_cannot_change_parsed_grant(self):
+        expected = hashlib.sha256(self.grant_file.read_bytes()).hexdigest()
+        original_parse = once.strict_json
+        def mutate_after_hash(raw):
+            changed = dict(self.approval, grant=dict(self.approval['grant'], sender_id=999))
+            self.grant_file.write_text(json.dumps(changed))
+            return original_parse(raw)
+        with patch.object(once, 'strict_json', side_effect=mutate_after_hash):
+            approved = once.read_grant(self.grant_file, self.now, expected)
+        self.assertEqual(approved.sender_id, 42)
+
     def test_missing_grant_and_unknown_args_are_redacted(self):
         self.grant_file.unlink()
         self.assertEqual(self.invoke()[0], 2)
