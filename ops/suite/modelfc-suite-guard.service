[Unit]
Description=Trusted admission and lifecycle guard for isolated ModelFC suite

PropagatesStopTo=modelfc-suite-worker.service

[Service]
Type=notify
NotifyAccess=main
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -I -B /usr/lib/modelfc-suite/guard.py supervise
RuntimeMaxSec=420
TimeoutStartSec=30
TimeoutStopSec=30
KillMode=control-group
SendSIGKILL=yes
FileDescriptorStoreMax=1
FileDescriptorStorePreserve=yes
CollectMode=inactive
Restart=no
StandardInput=null
StandardOutput=null
StandardError=null
UMask=0077
