[Unit]
Description=Run the authorized one-shot Model FC OddsPapi tournament experiment
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=modelfc-runtime
Group=modelfc-runtime
WorkingDirectory=/srv/modelfc/current
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/modelfc-tournament-research-launch.py
LoadCredential=oddspapi.key:/etc/modelfc/credentials/oddspapi.key
LoadCredential=tournament-authorization.json:/etc/modelfc/oddspapi-tournament-research.json
UMask=0077
StandardInput=null
UnsetEnvironment=GITHUB_TOKEN GH_TOKEN SSH_AUTH_SOCK PYTHONPATH PYTHONHOME LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT ODDSPAPI_API_KEY
TimeoutStartSec=10min
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/srv/modelfc /etc/modelfc
ReadWritePaths=/var/lib/modelfc/state
InaccessiblePaths=-/var/lib/modelfc-deploy -/run/modelfc-acquisition
InaccessiblePaths=-/etc/modelfc-validator -/var/lib/modelfc-validator
InaccessiblePaths=-/opt/modelfc-deploy -/opt/modelfc-validator
InaccessiblePaths=-/etc/modelfc/credentials
InaccessiblePaths=-/root/modelfc-state -/root
CapabilityBoundingSet=
RestrictSUIDSGID=yes

[Install]
# Deliberately no timer. Installation and the single start require separate authorization.
