# Resolve symlinks in the projected root, not against the host's absolute paths.
def resolve_virtual(path):
    todo=list(pathlib.PurePosixPath(path).parts[1:]); current=[]; links=0
    while todo:
        part=todo.pop(0)
        if part in ('','.'):
            continue
        if part=='..':
            assert current,'ROOTFS_LINK_ESCAPE'
            current.pop(); continue
        candidate=ROOT.joinpath(*current,part)
        if candidate.is_symlink():
            links+=1; assert links<=16
            target=os.readlink(candidate)
            if target.startswith('/'):
                current=[]
            todo=list(pathlib.PurePosixPath(target).parts)[1 if target.startswith('/') else 0:]+todo
        else:
            current.append(part)
    final=ROOT.joinpath(*current)
    assert final.exists() and not final.is_symlink()
    return '/'+str(final.relative_to(ROOT))
