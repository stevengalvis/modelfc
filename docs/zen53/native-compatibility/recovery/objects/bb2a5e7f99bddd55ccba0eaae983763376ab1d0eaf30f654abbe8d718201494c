"""Data-only package constructor. Never launches a unit, bwrap or Codex."""
import os
import sys
import time
import select
import stat
import hashlib
import json
import pathlib
import shutil
import subprocess
import datetime

BASE = pathlib.Path(__file__).resolve().parent
ROOT = BASE / "rootfs"
PACKAGE = pathlib.Path("/root/.codex/packages/standalone/releases/0.162.1-x86_64-unknown-linux-musl")
ROOT.mkdir(mode=0o755)
for name in ("usr/bin", "usr/lib", "usr/lib64", "etc/codex", "opt/codex/bin", "diagnostic",
             "proc", "sys/fs/cgroup", "dev/shm", "dev/pts", "dev/mqueue", "dev/hugepages",
             "tmp", "var/tmp", "run", "empty-home"):
    (ROOT / name).mkdir(mode=0o755, parents=True, exist_ok=True)
for name, target in (("lib", "usr/lib"), ("lib64", "usr/lib64"), ("bin", "usr/bin")):
    (ROOT / name).symlink_to(target)
dependencies = {}


def sha(path):
    h = hashlib.sha256()
    with open(path, "rb") as stream:
        while data := stream.read(65536):
            h.update(data)
    return h.hexdigest()


def copy(source, destination=None, executable=False):
    original = pathlib.Path(source)
    resolved = original.resolve(strict=True)
    dest = destination or str(resolved)
    target = ROOT / dest.lstrip("/")
    target.parent.mkdir(parents=True, exist_ok=True)
    if not target.exists():
        shutil.copyfile(resolved, target)
        os.chmod(target, 0o555 if executable else 0o444)
    metadata = resolved.stat()
    dependencies[dest] = {"source": str(original), "resolved_source": str(resolved),
                          "sha256": sha(target), "source_uid": metadata.st_uid,
                          "source_gid": metadata.st_gid, "source_mode": oct(stat.S_IMODE(metadata.st_mode)),
                          "mode": oct(stat.S_IMODE(target.stat().st_mode))}
    return target


# Metadata-only module discovery, no imported diagnostic/controller modules.
# os/sys/time/select/stat are frozen or built-in on this exact interpreter.
discovery = ('import os,sys,time,select,json,stat,hashlib; '
             'print(json.dumps(sorted({m.__file__ for m in sys.modules.values() '
             'if getattr(m,"__file__",None) and '
             'getattr(getattr(m,"__spec__",None),"origin",None)!="frozen"})))')
discovered = subprocess.run(["/usr/bin/python3", "-I", "-S", "-B", "-c", discovery],
                            check=True, capture_output=True, text=True)
module_files = set(json.loads(discovered.stdout))
assert all(path.startswith("/usr/lib/python3.12/") for path in module_files)
for name in ("encodings/ascii.py", "encodings/latin_1.py"):
    module_files.add("/usr/lib/python3.12/" + name)
for path in sorted(module_files):
    copy(path)
copy("/usr/bin/python3.12", executable=True)
(ROOT / "usr/bin/python3").symlink_to("python3.12")
copy(PACKAGE / "bin/codex", "/opt/codex/bin/codex", True)
copy(PACKAGE / "codex-package.json", "/opt/codex/codex-package.json")
copy("/usr/bin/bwrap", "/usr/bin/bwrap", True)
# Effective package-managed mode retained for exact read-only bind over this file.
os.chmod(ROOT / "usr/bin/bwrap", 0o755)
dependencies["/usr/bin/bwrap"]["mode"] = "0o755"
for name in ("report.py", "launch.py"):
    copy(BASE / name, "/diagnostic/" + name)

# Static ELF dependency closure. readelf parses files; never ldd or execute inputs.
queue = [path for path in dependencies if (ROOT / path.lstrip("/")).read_bytes()[:4] == b"\x7fELF"]
done = set()
elf = {}
while queue:
    dest = queue.pop()
    if dest in done:
        continue
    done.add(dest)
    source = dependencies[dest]["resolved_source"]
    dynamic = subprocess.run(["readelf", "-d", source], check=True, capture_output=True, text=True).stdout
    program = subprocess.run(["readelf", "-l", source], check=True, capture_output=True, text=True).stdout
    needed = [line.split("[", 1)[1].split("]", 1)[0] for line in dynamic.splitlines()
              if "(NEEDED)" in line]
    loaders = [line.split("interpreter: ", 1)[1].split("]", 1)[0] for line in program.splitlines()
               if "Requesting program interpreter:" in line]
    elf[dest] = {"needed": needed, "interpreters": loaders}
    for name in needed + loaders:
        source_path = pathlib.Path(name) if name.startswith("/") else pathlib.Path("/usr/lib/x86_64-linux-gnu") / name
        canonical = source_path.resolve(strict=True)
        target = copy(canonical, executable=bool(canonical.stat().st_mode & 0o111))
        canonical_destination = "/" + str(target.relative_to(ROOT))
        if name.startswith("/"):
            alias = ROOT / name.lstrip("/")
        else:
            alias = ROOT / "usr/lib/x86_64-linux-gnu" / name
        if alias != target and not alias.is_symlink():
            alias.parent.mkdir(parents=True, exist_ok=True)
            alias.symlink_to(canonical_destination)
        queue.append(canonical_destination)

(BASE / "evidence").mkdir(mode=0o700)
empty = {}
bindings = []
for name, destination in (("empty-home", "/empty-home"), ("empty-tmp", "/tmp"),
                           ("empty-vartmp", "/var/tmp"), ("empty-run", "/run"),
                           ("empty-shm", "/dev/shm")):
    source = BASE / name
    source.mkdir(mode=0o555)
    info = source.stat()
    empty[destination] = [info.st_dev, info.st_ino]
    bindings.append(str(source) + ":" + destination)
bindings.append("/usr/bin/bwrap:/usr/bin/bwrap")

requirements = '''default_permissions = "zen53_diagnostic"
allowed_approval_policies = ["never"]

[allowed_permission_profiles]
zen53_diagnostic = true

[permissions.zen53_diagnostic.filesystem]
":root" = "read"

[permissions.zen53_diagnostic.network]
enabled = false
'''
(BASE / "requirements.toml").write_text(requirements)
copy(BASE / "requirements.toml", "/etc/codex/requirements.toml")
pins = {"files": {name: record["sha256"] for name, record in dependencies.items()
                  if name != "/usr/bin/bwrap"},
        "bwrap_sha256": "e318903862396f96de3df57264e0158682b952fd3fb53ac23d876413e7b30f71",
        "empty_directories": empty}
(ROOT / "diagnostic/pins.json").write_text(json.dumps(pins, indent=2) + "\n")
os.chmod(ROOT / "diagnostic/pins.json", 0o444)

properties = {
    "RemainAfterExit": "yes", "DynamicUser": "yes", "User": "zen53-mincompat", "RootDirectory": str(ROOT),
    "MountAPIVFS": "yes", "WorkingDirectory": "/diagnostic",
    "PrivateNetwork": "yes", "RestrictAddressFamilies": "AF_UNIX AF_NETLINK",
    "NoNewPrivileges": "yes", "CapabilityBoundingSet": "", "AmbientCapabilities": "",
    "ProtectProc": "invisible", "ProcSubset": "all", "PrivateUsers": "no",
    "ProtectKernelTunables": "yes", "ProtectKernelModules": "yes", "ProtectControlGroups": "yes",
    "ProtectSystem": "strict", "ProtectHome": "yes", "PrivateDevices": "yes",
    "DevicePolicy": "closed", "RestrictSUIDSGID": "yes", "PrivateTmp": "yes",
    "CPUQuota": "50%", "MemoryHigh": "256M", "MemoryMax": "384M", "MemorySwapMax": "0",
    "TasksMax": "32", "RuntimeMaxSec": "60", "TimeoutStopSec": "3", "KillMode": "control-group",
    "SendSIGKILL": "yes", "Restart": "no", "OOMPolicy": "kill", "Nice": "19", "IOWeight": "10",
    "LimitCORE": "0", "LimitNOFILE": "128", "LimitFSIZE": "64K", "UMask": "0077",
    "StandardInput": "null", "StandardOutput": "append:" + str(BASE / "evidence/stdout.log"),
    "StandardError": "append:" + str(BASE / "evidence/stderr.log"),
    "ReadOnlyPaths": "/ /run /dev /dev/shm /tmp /var/tmp /empty-home",
    "InaccessiblePaths": "/dev/mqueue /dev/hugepages",
    "BindReadOnlyPaths": " ".join(bindings),
    "Environment": 'PATH=/usr/bin:/bin HOME=/empty-home CODEX_HOME=/empty-home LANG=C.UTF-8 LC_ALL=C.UTF-8 TMPDIR=/tmp TERM=dumb NO_COLOR=1 RUST_LOG=off PYTHONDONTWRITEBYTECODE=1',
}
unit = "[Unit]\nDescription=ZEN-53 one credential-free read-only compatibility diagnostic\n\n[Service]\nType=exec\n"
unit += "".join(key + "=" + value + "\n" for key, value in properties.items())
unit += "ExecStart=/usr/bin/python3 -I -S -B /diagnostic/launch.py\n"
(BASE / "diagnostic.service").write_text(unit)

for path in ROOT.rglob("*"):
    if path.is_dir() and not path.is_symlink():
        os.chmod(path, 0o555)
os.chmod(ROOT, 0o555)
source_dir = pathlib.Path("/tmp/zen53-readonly-audit-gh9lgs6f")
for name in ("source-launcher.rs", "source-bundled_bwrap.rs", "cli-debug.rs", "sandbox-bwrap.rs",
             "source-linux_run_main.rs", "source-bwrap.rs", "sources.json"):
    shutil.copyfile(source_dir / name, BASE / "source" / name)
symlinks = {"/" + str(path.relative_to(ROOT)): os.readlink(path)
            for path in ROOT.rglob("*") if path.is_symlink()}
evidence = {"prepared_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "python": sys.version, "interpreter_sha256": sha("/usr/bin/python3.12"),
            "dependencies": dependencies, "symlinks": symlinks, "elf_closure": elf,
            "source_commit": "092d3acd6bec3e3a14bdc7e7a2810ab628ab759d",
            "native_executions": 0, "unit_or_mount_operations": 0}
(BASE / "DEPENDENCIES.json").write_text(json.dumps(evidence, indent=2) + "\n")
for name in ("report.py", "launch.py", "supervisor.py", "prepare.py", "requirements.toml", "diagnostic.service", "DEPENDENCIES.json"):
    os.chmod(BASE / name, 0o444)
print(json.dumps({"stage": str(BASE), "rootfs_files": len(dependencies), "symlinks": len(symlinks),
                  "elf_files": len(elf), "native_executions": 0}))
