(BASE/'prepare.py').write_text(prepared)
(BASE/'constructor.diff').write_text(''.join(difflib.unified_diff(original.splitlines(True),prepared.splitlines(True),fromfile='baseline/prepare.py',tofile='revised/prepare.py')))
(BASE/'source-input').mkdir(mode=0o700)
for path in (OLD/'source').iterdir():
    assert path.is_file() and not path.is_symlink()
    shutil.copyfile(path,BASE/'source-input'/path.name)

