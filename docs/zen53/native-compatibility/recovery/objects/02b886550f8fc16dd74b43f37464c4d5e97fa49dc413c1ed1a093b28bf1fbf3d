# Attribute true to the installed package, with no execution of utility or loader.
source=pathlib.Path('/usr/bin/true')
info=source.lstat()
assert stat.S_ISREG(info.st_mode) and info.st_uid==info.st_gid==0 and stat.S_IMODE(info.st_mode)==0o755 and info.st_nlink==1
assert source.resolve()==source and pathlib.Path('/bin/true').resolve()==source
assert 'security.capability' not in os.listxattr(source)
md5lines=pathlib.Path('/var/lib/dpkg/info/coreutils.md5sums').read_text().splitlines()
md5record=next(line.split() for line in md5lines if line.split()[-1]=='usr/bin/true')
assert hashlib.md5(source.read_bytes()).hexdigest()==md5record[0]
for parent in source.parents:
    item=parent.lstat()
    assert stat.S_ISDIR(item.st_mode) and item.st_uid==0 and not item.st_mode&0o022
package=run(['/usr/bin/dpkg-query','-W','-f=${Package} ${Version} ${Architecture}\n','coreutils'])
assert package.returncode==0
true_evidence={'canonical_path':str(source),'aliases':['/usr/bin/true','/bin/true'],'uid':info.st_uid,'gid':info.st_gid,'mode':oct(stat.S_IMODE(info.st_mode)),'nlink':info.st_nlink,'device':info.st_dev,'inode':info.st_ino,'sha256':digest(source),'package':package.stdout.decode().strip(),'installed_package_md5_match':True,'file_capability':False,'executions':0}
for option,label in [('-d','dynamic'),('-l','program_headers')]:
    result=run(['/usr/bin/readelf',option,str(source)])
    assert result.returncode==0
    (BASE/('true.'+label+'.txt')).write_bytes(result.stdout)
(BASE/'TRUE_PROVENANCE.json').write_text(json.dumps(true_evidence,indent=2)+'\n')

