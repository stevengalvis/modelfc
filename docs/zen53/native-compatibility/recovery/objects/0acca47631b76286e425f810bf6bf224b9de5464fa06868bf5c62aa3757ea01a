    done.add(dest)
    source = dependencies[dest]["resolved_source"]
    dynamic = subprocess.run(["readelf", "-d", source], check=True, capture_output=True, text=True).stdout
    program = subprocess.run(["readelf", "-l", source], check=True, capture_output=True, text=True).stdout
