        source_path = pathlib.Path(name) if name.startswith("/") else pathlib.Path("/usr/lib/x86_64-linux-gnu") / name
        canonical = source_path.resolve(strict=True)
        target = copy(canonical, executable=bool(canonical.stat().st_mode & 0o111))
        canonical_destination = "/" + str(target.relative_to(ROOT))
        if name.startswith("/"):
            alias = ROOT / name.lstrip("/")
        else:
            alias = ROOT / "usr/lib/x86_64-linux-gnu" / name
        if alias != target and not alias.is_symlink():
            alias.parent.mkdir(parents=True, exist_ok=True)
            alias.symlink_to(canonical_destination)
        queue.append(canonical_destination)

