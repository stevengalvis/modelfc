[Unit]
Description=ZEN-53 one credential-free read-only compatibility diagnostic

[Service]
Type=exec
RemainAfterExit=yes
DynamicUser=yes
User=zen53-mincompat
RootDirectory=/tmp/zen53-empty-bind-preparation-c4dc2b6bff2d4cafe744ca2134c852a0/rootfs
MountAPIVFS=yes
WorkingDirectory=/diagnostic
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProcSubset=all
PrivateUsers=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
DevicePolicy=closed
RestrictSUIDSGID=yes
PrivateTmp=yes
MountFlags=private
CPUQuota=50%
MemoryHigh=256M
MemoryMax=384M
MemorySwapMax=0
TasksMax=32
RuntimeMaxSec=60
TimeoutStopSec=3
KillMode=control-group
SendSIGKILL=yes
Restart=no
OOMPolicy=kill
Nice=19
IOWeight=10
LimitCORE=0
LimitNOFILE=128
LimitFSIZE=64K
UMask=0077
StandardInput=null
StandardOutput=append:/tmp/zen53-empty-bind-preparation-c4dc2b6bff2d4cafe744ca2134c852a0/evidence/stdout.log
StandardError=append:/tmp/zen53-empty-bind-preparation-c4dc2b6bff2d4cafe744ca2134c852a0/evidence/stderr.log
ReadOnlyPaths=+/ +/dev +/tmp +/var/tmp +/empty-home
InaccessiblePaths=+/dev/mqueue +/dev/hugepages
BindReadOnlyPaths=/tmp/zen53-empty-bind-preparation-c4dc2b6bff2d4cafe744ca2134c852a0/empty-home:/empty-home /tmp/zen53-empty-bind-preparation-c4dc2b6bff2d4cafe744ca2134c852a0/daemon-tmp:/tmp /tmp/zen53-empty-bind-preparation-c4dc2b6bff2d4cafe744ca2134c852a0/empty-vartmp:/var/tmp /usr/bin/bwrap:/usr/bin/bwrap
TemporaryFileSystem=/run:ro,nosuid,nodev,noexec,size=64K,nr_inodes=32,mode=0755 /dev/shm:ro,nosuid,nodev,noexec,size=64K,nr_inodes=32,mode=0755 /run/zen53-bookkeeping:rw,nosuid,nodev,noexec,size=1M,nr_inodes=64,mode=1777,uid=0,gid=0
Environment=PATH=/usr/bin:/bin HOME=/empty-home CODEX_HOME=/empty-home LANG=C.UTF-8 LC_ALL=C.UTF-8 TMPDIR=/run/zen53-bookkeeping TERM=dumb NO_COLOR=1 RUST_LOG=off PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -I -S -B /diagnostic/launch.py
